{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Strategic Narrative Builder 2.0 - Deploy Docker image to AWS App Runner",
  "Parameters": {
    "DockerImageUri": {
      "Type": "String",
      "Default": "strategicnarrative:latest",
      "Description": "Docker image URI or Docker Hub image name"
    },
    "ServiceName": {
      "Type": "String",
      "Default": "strategic-narrative-builder",
      "Description": "App Runner service name"
    },
    "Port": {
      "Type": "Number",
      "Default": 8787,
      "Description": "Container port"
    }
  },
  "Resources": {
    "AppRunnerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "apprunner.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonEC2ContainerRegistryReadOnly"
        ]
      }
    },
    "AppRunnerService": {
      "Type": "AWS::AppRunner::Service",
      "Properties": {
        "ServiceName": {
          "Ref": "ServiceName"
        },
        "SourceConfiguration": {
          "ImageRepository": {
            "ImageIdentifier": {
              "Ref": "DockerImageUri"
            },
            "ImageRepositoryType": "ECR_PUBLIC",
            "ImageConfiguration": {
              "Port": {
                "Ref": "Port"
              },
              "RuntimeEnvironmentVariables": [
                {
                  "Name": "PORT",
                  "Value": "8787"
                },
                {
                  "Name": "HOST",
                  "Value": "0.0.0.0"
                },
                {
                  "Name": "SNB_MAGIC_LINK_DEV_MODE",
                  "Value": "0"
                }
              ]
            }
          }
        },
        "InstanceConfiguration": {
          "InstanceRoleArn": {
            "Fn::GetAtt": [
              "AppRunnerRole",
              "Arn"
            ]
          },
          "Cpu": "0.25",
          "Memory": "512"
        },
        "AutoDeploymentsEnabled": true
      }
    }
  },
  "Outputs": {
    "AppRunnerServiceUrl": {
      "Description": "App Runner Service URL",
      "Value": {
        "Fn::GetAtt": [
          "AppRunnerService",
          "ServiceUrl"
        ]
      }
    }
  }
}
