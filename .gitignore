# Local SQLite databases (contain secrets, sessions and customer data)
data/*.db
data/*.db-wal
data/*.db-shm

# Encryption key material — must never be committed
data/.snb_secret.key
*.key

# Uploaded knowledge-base documents and generated output
storage/uploads/
output/

# Python
__pycache__/
*.pyc
.pythonlibs/

# Node
node_modules/
package.json
package-lock.json

# Claude Code harness files (local tooling, not part of the app)
.claude/

# OS / editor
.DS_Store

# Replit hosting artefacts (the app deploys to AWS; these are recreated
# locally by Replit tooling and are not part of the deployment)
.replit
replit.md
.upm/
